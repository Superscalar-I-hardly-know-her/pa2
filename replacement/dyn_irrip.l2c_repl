#include "cache.h"
#include <cmath>
#include <cstdlib>
#include <cstring>

#define maxRRPV 3

uint8_t rrpv[L2C_SET][L2C_WAY];
const uint32_t window_size = 4096;
uint32_t instruction_accesses, data_accesses, instruction_misses, data_misses;
bool prioritize_instructions, start_in_irrip, persistent_switching, prefetch_aware;
unsigned rrip_streak;
double threshold;
uint64_t windows, switches, roi_rrip_loads, roi_irrip_loads;
uint64_t roi_prefetch_fills, roi_prefetch_hits;

bool flag(const char *name)
{
    const char *value = std::getenv(name);
    if (!value)
        return false;
    if (!std::strcmp(value, "0"))
        return false;
    if (!std::strcmp(value, "1"))
        return true;

    std::cerr << "Invalid " << name << ": " << value << endl;
    std::exit(1);
}

// One RRIP leader in each 32-set group, with a different offset per group.
bool leader(uint32_t set)
{
    return (set & 31) == (set >> 5);
}

void observe(uint32_t cpu, bool instruction, bool hit)
{
    if (instruction) {
        instruction_accesses++;
        if (!hit)
            instruction_misses++;
    }
    else {
        data_accesses++;
        if (!hit)
            data_misses++;
    }

    if (instruction_accesses + data_accesses != window_size)
        return;

    uint32_t misses = instruction_misses + data_misses;
    double share = 0;
    if (misses)
        share = double(instruction_misses) / misses;

    // strictly above the threshold enables I-RRIP; equality stays on RRIP
    bool next_mode = share > threshold;
    if (persistent_switching) {
        next_mode = prioritize_instructions;
        if (misses && share > threshold) {
            next_mode = true;
            rrip_streak = 0;
        }
        else if (misses && share < threshold) {
            if (rrip_streak < 2)
                rrip_streak++;
            if (rrip_streak == 2)
                next_mode = false;
        }
        else {
            // No misses or exact equality supplies no reason to change mode and
            // breaks the sequence of consecutive below-threshold windows.
            rrip_streak = 0;
        }
    }

    bool changed = next_mode != prioritize_instructions;
    windows++;
    switches += changed;
    cout << "DYN_WINDOW index=" << windows << " phase=" << (warmup_complete[cpu] ? "roi" : "warmup")
         << " i_access=" << instruction_accesses << " d_access=" << data_accesses
         << " i_miss=" << instruction_misses << " d_miss=" << data_misses
         << " share=" << share << " mode=" << (next_mode ? "IRRIP" : "RRIP")
         << " switched=" << changed << " rrip_streak=" << rrip_streak << endl;

    prioritize_instructions = next_mode;
    instruction_accesses = 0;
    data_accesses = 0;
    instruction_misses = 0;
    data_misses = 0;
}

void CACHE::l2c_initialize_replacement()
{
    static_assert(L2C_SET == 1024, "Leader mapping assumes the assignment's 1024 L2 sets");

    threshold = 0.25;
    if (const char *value = std::getenv("DYN_IRRIP_THRESHOLD")) {
        char *end;
        threshold = std::strtod(value, &end);
        if (end == value || *end || !std::isfinite(threshold) || threshold < 0 || threshold > 1) {
            std::cerr << "Invalid DYN_IRRIP_THRESHOLD: " << value << endl;
            std::exit(1);
        }
    }

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++)
            rrpv[i][j] = maxRRPV;
    }

    instruction_accesses = 0;
    data_accesses = 0;
    instruction_misses = 0;
    data_misses = 0;
    start_in_irrip = flag("DYN_IRRIP_START");
    persistent_switching = flag("DYN_IRRIP_PERSIST");
    prefetch_aware = flag("DYN_IRRIP_PREFETCH");
    prioritize_instructions = start_in_irrip;
    rrip_streak = 0;
    windows = 0;
    switches = 0;
    roi_rrip_loads = 0;
    roi_irrip_loads = 0;
    roi_prefetch_fills = 0;
    roi_prefetch_hits = 0;

    cout << "Dynamic I-RRIP threshold=" << threshold << " leaders=32 window=" << window_size
         << " initial=" << (start_in_irrip ? "IRRIP" : "RRIP") << " persistent=" << persistent_switching
         << " selected_insert=2 selected_data_hit=1 selected_bias=2 prefetch_aware=" << prefetch_aware << endl;
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    for (int i=0; i<L2C_WAY; i++) {
        if (!current_set[i].valid)
            return i;
    }

    // leader sets always use SRRIP; followers use I-RRIP only while that mode is selected
    bool aware = !leader(set) && prioritize_instructions;

    while (1)
    {
        int distant = -1;
        int data = -1;

        for (int i=0; i<L2C_WAY; i++) {
            if (rrpv[set][i] == maxRRPV && distant < 0)
                distant = i;

            if (!current_set[i].instruction && (data < 0 || rrpv[set][i] > rrpv[set][data]))
                data = i;
        }

        if (distant >= 0) {
            // selected eviction bias is 2, so a data line at RRPV >= 1 is preferred
            if (aware && data >= 0 && rrpv[set][data] >= 1)
                return data;

            return distant;
        }

        for (int i=0; i<L2C_WAY; i++) {
            if (rrpv[set][i] < maxRRPV)
                rrpv[set][i]++;
        }
    }

    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    bool is_leader = leader(set);
    bool aware = !is_leader && prioritize_instructions;

    // On fills the block still describes the victim. On hits the resident type is sticky.
    bool instruction;
    if (hit)
        instruction = block[set][way].instruction;
    else
        instruction = isInstruction && (type == LOAD || type == PREFETCH);

    // Task 3: a follower data prefetch is inserted at eviction priority, and a
    // prefetch hit does not promote it. Leaders stay on ordinary SRRIP.
    if (prefetch_aware && !is_leader && type == PREFETCH && !isInstruction) {
        if (!hit)
            rrpv[set][way] = maxRRPV;

        if (warmup_complete[cpu]) {
            if (hit)
                roi_prefetch_hits++;
            else
                roi_prefetch_fills++;
        }
        return;
    }

    // Both policies insert at RRPV 2. Only data promotion and eviction change modes.
    if (hit) {
        if (aware && !instruction)
            rrpv[set][way] = 1;
        else
            rrpv[set][way] = 0;
    }
    else
        rrpv[set][way] = maxRRPV-1;

    // Translation, prefetch, RFO and writeback do not train the controller.
    if (type != LOAD)
        return;

    if (is_leader) {
        // Demand hits and completed miss fills match the simulator's load statistics.
        // MSHR-merged requests share one fill observation. The new mode applies afterwards.
        observe(cpu, isInstruction, hit);
    }
    else if (warmup_complete[cpu]) {
        if (aware)
            roi_irrip_loads++;
        else
            roi_rrip_loads++;
    }
}

void CACHE::l2c_replacement_final_stats()
{
    cout << "DYN_SUMMARY windows=" << windows << " switches=" << switches
         << " roi_rrip_loads=" << roi_rrip_loads << " roi_irrip_loads=" << roi_irrip_loads
         << " pending_i_access=" << instruction_accesses << " pending_d_access=" << data_accesses
         << " pending_i_miss=" << instruction_misses << " pending_d_miss=" << data_misses
         << " roi_prefetch_fills=" << roi_prefetch_fills
         << " roi_prefetch_hits=" << roi_prefetch_hits << endl;
}
